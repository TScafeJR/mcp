{
  "name": "@tscafejr/mcp",
  "version": "0.5.1",
  "description": "MCP servers by TScafeJR.",
  "license": "MIT",
  "author": "Tyrone Scafe",
  "type": "module",
  "bin": {
    "mcp": "dist/servers/mcp.js",
    "mcp-db": "dist/servers/db.js",
    "mcp-visualizer": "dist/servers/visualizer.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && node scripts/chmod-bins.js",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "dev": "node scripts/run.js dev",
    "start": "node scripts/run.js start",
    "format": "prettier --write . --log-level silent",
    "format:check": "prettier --check .",
    "release": "node scripts/release.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "pg": "8.23.0",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "puppeteer": "24.42.0"
  },
  "devDependencies": {
    "@types/node": "25.6.0",
    "@types/pg": "8.23.1",
    "@types/pngjs": "6.0.5",
    "prettier": "3.9.6",
    "tsx": "4.21.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
